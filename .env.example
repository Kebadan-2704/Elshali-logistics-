# ==============================================================================
# ELSHALI LOGISTICS & TRANSPORT — Environment Variables Configuration
# ==============================================================================

# Primary Canonical Domain (One Single Source of Truth)
# Default is printed on visiting card (https://www.elshali.com).
# Owner must confirm DNS routing in OWNER_ACTIONS.md.
NEXT_PUBLIC_SITE_URL=https://www.elshali.com

# ------------------------------------------------------------------------------
# Lead Capture & Durable Multi-Channel Notification Configuration
# At least ONE durable channel (Resend, Telegram, or Webhook) should be active.
# ------------------------------------------------------------------------------

# 1. Resend Email Dispatch (Optional)
RESEND_API_KEY=
LEAD_EMAIL_TO=elshalilogistics@gmail.com
LEAD_EMAIL_FROM=onboarding@resend.dev
CONTACT_EMAIL=elshalilogistics@gmail.com

# 2. Telegram Bot Dispatch (Instant mobile push notifications to dispatch desk)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. External Webhook (e.g. Google Sheets Apps Script Web App URL or CRM)
LEAD_WEBHOOK_URL=

# 4. Strict Configuration Flag
# If set to true, production build will fail if zero durable channels are set.
STRICT_LEAD_CONFIG=false

# ------------------------------------------------------------------------------
# AI Dispatch Assistant Configuration (Optional)
# If LLM_API_KEY is empty, the chat assistant gracefully falls back to direct call/WhatsApp.
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# Rate Limiting (Optional: Upstash Redis for distributed multi-instance deployment)
# If unconfigured, falls back to in-memory sliding window rate limiting.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
